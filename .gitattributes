# Normalize line endings for all text files
* text=auto

# Python / notebooks
*.py text eol=lf
*.ipynb text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Docs / config
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary — never diff/merge
*.pkl binary
*.cbm binary
*.db binary
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg binary
*.pptx binary
*.rar binary

# Model payloads go through Git LFS (card #7). Only the pickles: `manifest.json` and
# `current.json` stay plain text so a clone that never ran `git lfs pull` (the CI fast lane)
# still reads what a version is and whether its gates passed. `-text` because a pickle is bytes,
# and the `* text=auto` above must not touch them.
artifacts/v[0-9]*/*.joblib filter=lfs diff=lfs merge=lfs -text
