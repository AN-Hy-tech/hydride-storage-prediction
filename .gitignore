# Everything the new pipeline writes. hydms/config/pipeline.yaml already claimed these were
# gitignored; four of the five were not, and the first `python -m hydms.gates run` would have
# dropped artifacts/gate-results.json into the working tree as an untracked file. Card #5.
/artifacts/
/data/interim/
/data/processed/
/data/splits/

# ── Test cache ────────────────────────────────────────────────────────────────
.pytest_cache/

# ── IDE / tool settings ───────────────────────────────────────────────────────
.vscode/
.idea/
# Claude Code: keep skills versioned, keep local settings private
.claude/*
!.claude/skills/
!.claude/skills-lock.json
*.sublime-project
*.sublime-workspace

# ── graphify ──────────────────────────────────────────────────────────────────
# Keep GRAPH_REPORT.md, graph.json, graph.html and cost.json: rebuilding the graph costs
# real tokens, so the built index is worth versioning. Drop the machine-local state —
# these hold absolute paths from whichever machine last ran the build.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/
graphify-out/manifest.json

